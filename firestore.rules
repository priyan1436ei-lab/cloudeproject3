rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user is the resource owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Check if user has admin claim
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@documind-admin\\.internal')
      );
    }

    // User profile collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // User documents collection
    match /documents/{documentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Document analyses collection
    match /documentAnalyses/{analysisId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Document chunks (for RAG vector/keyword search)
    match /documentChunks/{chunkId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Chat sessions and messages
    match /chatSessions/{sessionId} {
      allow read, write: if isOwner(resource.data.userId) || (request.resource.data.userId == request.auth.uid);
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // User notifications
    match /notifications/{notificationId} {
      allow read, write: if isOwner(resource.data.userId) || (request.resource.data.userId == request.auth.uid);
    }

    // Activity logs
    match /activityLogs/{logId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
    }

    // Admin platform metrics (strictly restricted)
    match /platformStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
